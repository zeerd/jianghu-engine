# corpse_and_dungeon.sce — 尸体腐烂（CCorpse::decay）→ 闯入山寨 → 离开副本
#
# 覆盖：CCorpse 的 120 拍腐烂计时（Corpse.cpp：m_delay=120，每拍 -1，到点播报
#   第一段腐烂文案并改名）、副本入口房间的菜单、CFB::load_fb_room / move_in、
#   副本管理员的离开菜单。
#
# ⚠ 并行隔离：腐烂播报是房间级且文案里没有「你」字（拼的是尸体名），无法靠
#   本人版区分，只能靠房间隔离——山顶只有本道，故本段独占山顶。副本是**全局
#   单例**，本道与 L8（山贼试炼）共用：本道只路过大厅找小头目离开、不打山贼，
#   山贼战归 L8——两道以「黑风寨已清」信号错峰（N4 拆分后：L8 清寨约 130s 即
#   进入 wait L3已到寨口，本道尸体腐烂约 240s 广播到寨口，L8 即回广播——
#   双方 wait 都先于对端信号启动，零同房窗口，见 §2.4 与 §8.6⑦ 双向握手）。
#
# 判定：`wait room` / `wait menu` / `wait object` 都是每客户端独立状态，
#   进出副本的每一步都落到确定的房间上，不靠文本猜。

# 尸体腐烂：遇害者尸体带 120 拍心跳，服务端 1 拍 = 1 秒，到点播报腐烂文案。
# 播报只发到尸体所在房间，所以必须留在山顶等它（树箱已在前面开过，这段就是干等）
wait text 开始腐烂了 timeout=180000

# ---------------------------------------------------------------------------
# 副本：闯入山寨 → 见副本管理员 → 离开副本
# ---------------------------------------------------------------------------
cmd /t 0
# L8 错峰的**双向频道握手**（§8.6⑦ 教训：私发信号若早于本 wait 3 分钟到达，
# 中间本链的 clear 会把它抹掉——第 5 轮实测 L8 17:09 发、本道 17:12 才 wait，
# 消息被沿途 clear 吞掉）。改为：本道先广播「L3已到寨口」，L8 战后 wait 到它
# 再回广播——两次到达都发生在**对端 wait 已启动之后**（毫秒级），且双方 wait
# 段内无 clear；频道用裸文本（cmd 不以 / 开头，L4 频道段同款）。「黑风寨已清」
# 特异词全服只有 L8 会发；L8 中途失败时本 wait 超时连带失败（§9 对端排查）。
cmd L3已到寨口
wait text 黑风寨已清 timeout=90000
# 穿行保险：L8 战后庭院可能存留两只 idle aggressive 山贼（仇恨已脱），穿行
# 0~2 拍内可能吃 1~2 击（68 点/击）——先补 2 粒回春把 hp 顶到 eff 上限
# （N4 拆分后本道不再升级，上限为 1 级的 405、eff 342）再进；两只山贼此刻
# 都处于与 L8 的战斗或刚脱战的 idle，L3 停留极短。
# 每粒间 sleep 3200（use 成功分支 start_busy(2)，busy 拒后续 use 与 /go——
# 旧链 3 级满血两粒都走拒绝分支不 busy，拆分后本道战后必掉血走成功分支，
# 必须逐粒等 busy 过拍；否则第二粒被拒、回执被第一粒旧文本假匹配）
repeat 2
cmd /t hui chun dan
clear
cmd /use
wait text 你吃下一粒回春丹|你现在不需要用回春丹 timeout=10000
sleep 3200
end
cmd /t 0
cmd /look
wait menu
menu 闯入山寨
wait room 黑风寨庭院

cmd /t 0
cmd /go 聚义大厅
wait room 黑风寨大厅

wait object 小头目
cmd /t xiao tou mu
cmd /talk
wait menu
menu 离开副本
wait room 青云山山顶
cmd /t 0
