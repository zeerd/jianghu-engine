# sleep_b.sce — wakeup2 双人同睡（B 侧：受邀方，女性账号）
#
# 与 sleep_a.sce 配对并行（本侧钉 wakeup2 的**女性分支**）。时序：
#   A 先到半山腰发第一声 /sleep（只落 pending + 私发邀请）→ 本侧等邀请私发
#   「看来…很想跟你」→ 回第二声 /sleep 触发真睡。
#   ⚠ 本侧**必须先等到邀请再 /sleep**：抢发会让本侧落进邀请分支变成双向
#   邀请（两边都在等对方的第二声），双方都醒不来、双双超时（§8.6④）。
#
# 真睡后收性别私发：女版「你躺在…的怀里，不由得心醉神迷」（与触发顺序无关，
#   性别决定收哪条——男恒收「搂着」、女恒收「躺着」，见 Sleep 尾段分支）。
# 自然醒收 wakeup2 女版私发「你醒了过来，脸上还挂着甜蜜的笑容。」
#
# 本侧无装备（输家账号保持 1 级徒手），睡时 unwield 0 all 无剑可卸，
#   醒后无需重挥——直接回山脚，fight_b 的 rendezvous 再与 A 会合。
# clear 位置（§8.6⑦）：只在片段开头（trade 握手已收口，对端无在途信号）；
#   邀请私发到达前后**全程无 clear**，任何一条都会把它抹掉并令本步干等。

clear
cmd /go 青云山半山腰
wait room 青云山半山腰 timeout=30000
wait object $peer timeout=180000

# --- 等 A 的第一声邀请（私发），收到才回第二声 -----------------------------
wait text 很想跟你 timeout=60000
cmd /t $peer_acct
cmd /sleep

# 第二声触发真睡 → 女版私发（含 $peer 名的怀里句）
wait text 你躺在 timeout=10000

# --- 自然醒：与 A 各自独立随机（10~33 秒），窗口给 60s ---------------------
# 女版私发（wakeup2 女性分支：「你醒了过来，脸上还挂着甜蜜的笑容。」）
wait text 你醒了过来 timeout=60000
cmd /t 0

# 回山脚与 A 会合（半山腰只有山脚/山顶两道门）
cmd /go 青云山山脚
wait room 青云山山脚 timeout=15000
