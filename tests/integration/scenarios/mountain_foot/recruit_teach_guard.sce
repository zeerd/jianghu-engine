# recruit_teach_guard.sce — 片尾三条命令流程自验：收徒经验查询 / 开革非法目标 / 传授前置
#
# 业务：三个「前置不满足即拒」的命令支——
#   · 本道从未收徒（无该角色的收徒记录）→ 收徒经验查询被拒；
#   · 定向的是 NPC（山脚向导）而非玩家扮演的角色 → 开革被拒；
#   · 角色无伴侣 → 传授（指点伴侣武功）被拒。
#   三条回执全为 notify_fail 私发，只有本人收得到（§8.4②），同房间他道账号无从串扰。
#
# 判定与前置：全在山脚做——开革的非法目标支要求目标与本人同房，而向导（老李头）常驻山脚；
#   换房后对象推送晚于 wait room 一拍，先 wait object 再定向（§8.5）。
#   目标纪律：块内唯一改目标的步是开革，块末 /t 0 收干净。
#
# 放置：由 lane_foot 在房屋段之后、/quit 之前 include——收徒/传授只看自身状态、不挑房间，
#   而道尾是零干扰插点（其后只剩 battle_end + quit）。本片单道独有，不被别的道复用。

cmd /go 青云山山脚
wait room 青云山山脚 timeout=15000
wait object 老李头 timeout=10000

# 收徒经验查询：本道从未收徒 → 拒绝文案私发本人
cmd /rexp
wait text 你还没有收徒经验 timeout=10000

# 开革的非法目标支：定向的是 NPC（山脚向导）而非玩家扮演的角色
cmd /t lao li
cmd /expell
wait text 你只能开革玩家 timeout=10000
cmd /t 0

# 传授的前置支：本道角色无伴侣，谈不上指点武功
cmd /teach
wait text 你还没有伴侣呢 timeout=10000
