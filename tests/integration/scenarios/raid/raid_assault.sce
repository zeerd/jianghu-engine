# raid_assault.sce — L8：闯入黑风寨开战，战斗窗口被动收割覆盖后接信号
#
# 覆盖方式（2026-10-31 拍板：**降断言**；2026-11-01 破障实测更新依据）：
#   · 原两目标现状：`l_perform_action`（山贼 chat_msg_combat 出招）**已烧**；
#     `l_receive_wound`（force 反震）经破障实测判**结构性不可达、列入不测**
#     ——force.lua:39-41 的 mp_you ≤ 3mp 封顶使 damage<0 恒不成立
#     （旧分析「山贼 mp500 → -4」漏看封顶）。
#   · **不反验反震/出招的现由**：一个已烧一个不测，剧本只验本段的确定性面
#     （开战 → 战斗收束 → 战后信号）。历史四重障碍仍解释「为什么本道不以
#     打赢为目标」：① 山贼 sp 6.5~14.6 万 vs 玩家 dp 顶格 5.1 万 → 我挨打
#     如喝水；② 我 sp 15500 < 山贼 DP≈4.9万/PP≈9.8万 → 拳拳 miss（破障实测
#     已量化阈值：set_skill unarmed 300 起 P(命中)≥91%，但破障无覆盖收益故
#     不改本道）；③ 战斗中 /use 需 50 AP（实测拒）→ 无法吃药拉窗；
#     ④ 攻击拍数受挨击硬直顶节奏。覆盖率是参考手段非通过门槛（design §5.2）。
#
# 战斗流程：kill（徒手全程——unarmed 攻击链是本道战斗形态，本道不换剑）→
#   战斗 → 败退「回家休养」（回山脚）或重伤复活（回客栈）——**两种结局都不等
#   特定房间**，战后直接发信号。
#
# 与 L3 的错峰（副本全局单例，design §2.4）：本道先开战（N4 拆分后约 110s），
#   战后 wait「L3已到寨口」（timeout 300s 覆盖树箱随机尾部）→ 收到即 tell
#   「黑风寨已清」；L3 约 225s（尸体腐烂 120 拍后）广播到寨口。本道若中途
#   失败，L3 的 wait 超时连带失败——排查按 §9 先看 lane8 日志。
#
# 时长预算：本段约 60s（爬山 10 + 进寨 10 + 战斗 13 + 信号/复活 10 + 裕度）。

# --- 入寨：半山腰直达山顶，副本入口菜单（/look 触发）--------------------------
cmd /go 青云山山顶
wait room 青云山山顶 timeout=15000
cmd /look
wait menu timeout=15000
menu 闯入山寨
wait room 黑风寨庭院 timeout=30000

# --- 守卫落位播报（脚本 init 在 spawned==0 时向全房 tell_room，全轮仅此一次） ----
# 本道进寨即收；L3 约 225s 后到庭院时 spawned 已置位、再见不到此条，故唯一无串扰。
# 若本步超时 = 错峰被打破、L3 抢先入寨——按 §9 先查 lane3 日志。
wait text 守门喽啰从墙后转出 timeout=10000

# --- 庭院观察：副本房没有自装的观察钩子，走引擎基座把房间长描述发给本人 ------
# 长描述走私发（观察回执只到眼前），上面那条守卫播报不进本断言；
# 山顶那个 /look 是菜单入口，与此处的纯观察互不相干。
cmd /look
wait text 黄土铺地 timeout=10000

# --- 开战（进房两只 aggressive 即会攻来；kill 是敌意锚定，全程徒手） -----------
wait object 山贼 timeout=30000
cmd /t shan zei
cmd /kill
wait battle

# --- 战斗窗口（败退/重伤收束，覆盖被动收割，见头注）--------------------------
# 山贼出招是 chat 概率触发（31 拍/次 ×随机），战斗时长天然长尾——90s 实测
# 有过一轮拉锯超时（2026-11-01），放宽到 240s 只等收束不断言时长；
# 败退/重伤两种结局都会清 fight 状态 → battle_end。
wait battle_end timeout=240000

# --- 双向频道握手的回端（见 corpse_and_dungeon 的 §8.6⑦ 教训） ----------------
# L3 到寨口会广播「L3已到寨口」——本 wait 启动必早于/晚于它到达都安全：
#   · L3 更早（L8 战后才到）：消息已在本段缓冲（本段与战斗间无 clear）；
#   · L3 更晚：wait 在等，到达即消费。
# 收到才回广播，L3 的 wait 在它之后毫秒级消费——两跳都无 clear 窗口。
wait text L3已到寨口 timeout=300000
cmd 黑风寨已清
cmd /t 0
